{
  // Белый список корней. Обязательное поле, минимум один путь.
  // project_dir из вызова должен лежать внутри одного из них, иначе запуск отклоняется.
  // В JSON обратные слэши экранируются: "D:\\Projects".
  "allowedRoots": ["D:\\Projects"],

  // Путь к бинарю Claude Code либо имя для поиска в PATH.
  // На Windows должен быть .exe: .cmd/.bat сервер отклонит, они требуют небезопасного shell.
  "claudeBin": "claude",

  // Путь к бинарю git либо имя для поиска в PATH — для инструмента run_git.
  // Дефолт "git" обычно работает даже с урезанным PATH, который Claude Desktop
  // даёт серверу на macOS: /usr/bin/git попадает и туда. Но ручка нужна по той же
  // причине, что и claudeBin: при промахе PATH инструмент иначе не починить.
  // Отсутствие git сервер не роняет — просто run_git не будет работать, о чём
  // при запуске пишется строка startup с component: "git".
  // На Windows должен быть .exe: .cmd/.bat отклоняются, они требуют shell.
  "gitBin": "git",

  // Модель по умолчанию для дочернего claude. Если не задать — CLI берёт свою
  // из ~/.claude/settings.json. Задавайте явно, когда та модель недоступна
  // headless-режиму: вызов упадёт с 403 ещё до начала работы. Пример: "claude-opus-5".
  // Отдельный вызов может переопределить это значение параметром model.
  // "model": "claude-opus-5",

  // Таймаут на зависший процесс, мс. 30 минут.
  "timeoutMs": 1800000,

  // Сколько секунд plan_task/execute_task ждут результата, прежде чем уйти в фон
  // и вернуть process_id. Держите ниже таймаута вашего MCP-клиента (обычно ~60 с).
  "defaultWaitSeconds": 20,

  // Предел одновременно запущенных процессов claude.
  "maxConcurrent": 3,

  // "auto" — передавать --sandbox только если CLI его поддерживает.
  // В версиях 2.1.177 и 2.1.268 такого флага нет, так что auto его не добавляет.
  "sandbox": "auto",

  // Переменные окружения, которые нужно пропустить дочернему процессу вопреки
  // чистке ANTHROPIC_*/CLAUDE_*. По умолчанию пусто — и менять это почти никогда не нужно.
  "passEnv": [],

  // JSONL-лог вызовов. Относительный путь считается от каталога конфига.
  "logFile": "./logs/ccc-mcp.jsonl",

  // Сколько символов текста задачи писать в лог.
  "logTaskTextChars": 200,

  // Писать ли в лог тело отчёта Claude Code. По умолчанию нет — лог остаётся компактным.
  "logResultText": false,

  // Писать ли в лог периодическую сводку живого состояния идущей задачи.
  // Это телеметрия, а не аудит: счётчики и имена инструментов, без текста модели
  // и без выжимок вызовов. По умолчанию false — для разбора одной задачи хватает
  // сводки в записи finish/timeout/cancel, а она пишется всегда, без флага.
  "logProgress": false,

  // Не чаще одной записи прогресса в этот интервал на задачу, мс. 1 минута.
  // Логируется не событие, а состояние по времени: событий у дочернего CLI
  // десятки в секунду, а так для 40-минутного прогона выходит ~40 строк.
  // Действует только при "logProgress": true.
  "logProgressIntervalMs": 60000,

  // Предел размера файла для read_project_file / write_project_file, байт. 512 KiB.
  // Один лимит на чтение и запись: иначе получился бы файл, который можно записать,
  // но нельзя прочитать обратно. Содержимое файлов в лог не пишется ни при каких
  // настройках — ни logTaskTextChars, ни logResultText на эти тулы не влияют.
  "maxFileBytes": 524288,

  // Предел числа записей в ответе list_project_files. 2000 — это примерно
  // 250 KB JSON, меньше половины maxFileBytes: бюджеты двух файловых сценариев
  // согласованы, а типичный репозиторий за вычетом игнор-листа укладывается
  // целиком. Превышение — не ошибка: придёт частичный список с truncated: true
  // и подсказкой сузить область. Сами пути в лог не пишутся ни при каких
  // настройках — только count и параметры запроса.
  "maxListEntries": 2000,

  // Предел объёма вывода одной git-операции (run_git), байт. 256 KiB.
  // Отдельно от maxFileBytes: тот про один файл, а дифф целой ветки бывает
  // больше на порядок. Превышение — не ошибка, в отличие от чтения файла:
  // придёт частичный патч с truncated: true и подсказкой сузить область
  // параметром path или запросить сводку через stat: true. Оборванный дифф
  // всё равно показывает, что происходит, — поэтому обрезать его честнее,
  // чем отказывать.
  "maxDiffBytes": 262144,

  // Таймаут одной git-операции, мс. 2 минуты.
  // Не секунды: git commit запускает pre-commit хуки репозитория, а они вполне
  // могут линтовать проект целиком. Хуки мост не отключает (--no-verify не
  // передаётся) — их отказ это осмысленный результат, а не сбой.
  "gitTimeoutMs": 120000,

  // Сколько держать завершённые задачи в памяти для get_task_status, мс. 1 час.
  "jobRetentionMs": 3600000,

  // Сколько живёт состояние сессии (planned/approved/executed), мс. Сутки.
  // Одобрение старше этого срока считается протухшим, и execute_task откажет:
  // нужно будет заново пройти plan_task → approve_plan.
  "sessionRetentionMs": 86400000,

  // --- Поток событий дочернего CLI -------------------------------------------
  // Запускать claude в режиме --output-format stream-json --verbose и разбирать
  // поток по мере поступления. Это то, из чего собирается объект progress: какие
  // инструменты вызывались, что идёт прямо сейчас, не зависла ли задача.
  //
  // Выключайте, если дочерний CLI перестал отдавать разбираемый stream-json
  // (признак — записи stream_warn в логе и отчёт без result_text): с false мост
  // возвращается к --output-format json и разбору одним куском, а живое состояние
  // задачи становится пустым. Ни одно поле отчёта при этом не меняет смысла —
  // финальная строка result в обоих режимах одна и та же.
  // Можно переключить переменной окружения CCC_STREAM_EVENTS=0.
  "streamEvents": true,

  // --- Пооперационные разрешения (PreToolUse-хуки) ---------------------------
  // Когда включено, execute_task запускает claude с HTTP-хуком на чувствительные
  // инструменты. Незнакомая операция получает мгновенный отказ с инструкцией
  // «дождись одобрения и повтори тот же вызов», а вы одобряете её асинхронно
  // тулом approve_permission_request. Запросы видны в get_task_status.
  //
  // ВНИМАНИЕ: по умолчанию false. Механизм держится на том, что модель реально
  // повторит отклонённый вызов; включайте только после ручной проверки на своей
  // версии CLI. Можно переключить переменной окружения CCC_HOOKS_ENABLED=1.
  "hooksEnabled": false,

  // Инструменты дочернего claude, требующие одобрения. На каждое имя ставится
  // отдельный PreToolUse-матчер. Остальные инструменты (Read, Grep, Glob …)
  // проходят без участия моста.
  // Полный список даёт максимальный контроль, но при permission_mode acceptEdits
  // превращает каждую правку файла в отдельное одобрение. Практичный вариант
  // для реальных задач — оставить только ["Bash"].
  "sensitiveTools": ["Bash", "Write", "Edit"],

  // Сколько раз один и тот же вызов может получить отказ, прежде чем будет
  // запрещён до конца задачи. Fail-closed: исчерпание бюджета — это вечный
  // отказ, а не разрешение. Сколько реального времени дадут эти попытки,
  // зависит от того, как дочерний CLI ждёт между повторами.
  "retryBudget": 10,

  // Предел числа различных запросов на разрешение в одной задаче — защита
  // памяти от модели, бесконечно перебирающей варианты аргументов.
  "maxPendingRequests": 50,

  // Пропускать ли `sleep N` (N ≤ 60) без одобрения — пауза, чтобы модель не
  // сжигала бюджет повторов мгновенными ретраями. Это разрешение моста, а не
  // гарантия: там, где `sleep` в Bash запрещён политикой самого CLI, модель
  // ждёт другим способом. Отключайте, только если Bash вообще не должен работать.
  "allowWaitCommand": true,

  // Команды Bash, которые мост пропускает без одобрения оператора. Работает
  // только при "hooksEnabled": true; по умолчанию список пуст, то есть механизм
  // выключен.
  //
  // Каждая строка — команда ЦЕЛИКОМ: сравнение посимвольное по всей строке
  // (лишние пробелы по краям отбрасываются, внутренние — нет). Ни префиксов, ни
  // шаблонов: "npm run typecheck && rm -rf /" под "npm run typecheck" не
  // подпадает, как и "npm run typecheck --watch".
  //
  // Семантику команд мост не проверяет — что сюда класть, решаете вы. Разумное
  // правило: только детерминированные проверки, не тратящие деньги и не ходящие
  // в сеть. "npm run smoke" без --no-live под него НЕ подходит: он порождает
  // дочерние процессы claude, то есть жжёт токены.
  //
  // Автоодобренный вызов не появляется в permission_requests — его единственный
  // след это строка лога с "decision": "auto_allowed".
  // Можно задать переменной окружения CCC_AUTO_APPROVE_COMMANDS (команды через ';').
  "autoApproveCommands": []
}
